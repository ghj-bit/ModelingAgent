  "content": "\"\"\"\nManaging Sustainable Tourism in Juneau, Alaska  (MCM 2025, Problem B)\n=====================================================================\nReproducible model implementation.\n\nComponents\n----------\n1.  Parameter calibration from the two verified empirical anchors.\n2.  Daily / peak-day social-welfare optimization  ->  efficient fee & cap (Pigouvian).\n3.  Seasonal simulation 2024-2035 under policy scenarios (status quo, caps, fees, integrated).\n4.  Revenue-reinvestment portfolio allocation (concave water-filling allocation).\n5.  Sensitivity analysis: one-at-a-time elasticities + variance-based Sobol' indices.\n6.  Adaptation to other destinations (overtourism stress index + policy-fit rule).\n\nRun:  python model.py\nOutputs: ../results/results.json , ../logs/model_run.log (stdout)\n\"\"\"\nimport os, json, math, sys, time\nimport numpy as np\nfrom scipy.optimize import minimize_scalar, minimize\nfrom scipy.stats import norm\n\nHERE = os.path.dirname(os.path.abspath(__file__))\nRES  = os.path.join(HERE, \"..\", \"results\")\nLOG  = os.path.join(HERE, \"..\", \"logs\")\nos.makedirs(RES, exist_ok=True)\nos.makedirs(LOG, exist_ok=True)\n\nRNG = np.random.default_rng(20250912)\n\n# =====================================================================\n# 1.  PARAMETERS  (calibrated / assumed; see report for justification)\n# =====================================================================\nP = dict(\n    # ---- population & baseline visitation -------------------------------\n    N_res        = 30_000,          # residents (problem statement)\n    C_2023       = 1_670_000,       # cruise passengers 2023 (CBJ report: 1.67M)\n    L_2023       =   200_000,       # independent/land overnight visitors 2023 (estimate)\n    season_days  =   200,           # Apr-Oct operating season (~200 days)\n    peak_C_2023  =  20_000,         # reported peak-day passengers (problem statement)\n\n    # ---- economic calibration ------------------------------------------\n    spend_pax    = 191.6,           # $ direct passenger spending / pax = 320e6/1.67e6\n    spend_line   = 23.4,            # $ cruise-line spending / pax    = 39e6/1.67e6\n    spend_crew   =  9.6,            # $ crew spending / pax           = 16e6/1.67e6\n    marine_rev   = 22.3e6,          # $ CBJ marine-related revenue 2023\n    retention    = 0.55,            # local value-added retention of private spend\n    sales_tax    = 0.05,            # CBJ areawide sales tax\n    bed_tax      = 0.07,            # transient lodging tax\n    head_tax0    = 5.0,             # current marine passenger fee ($/pax)\n    land_spend   = 250.0,           # $ / land visitor-day (lodging+F&B+activities)\n\n    # ---- environment -----------------------------------------------------\n    e_c          = 0.35,            # tCO2e per cruise visitor-day (ship + shore excursion)\n    e_l          = 0.12,            # tCO2e per land visitor-day (destination-attributable)\n    SCC          = 185.0,           # social cost of carbon $/tCO2e (US EPA 2023 central)\n\n    # ---- social / infrastructure ----------------------------------------\n    K0           = 10_000.0,        # \"comfortable\" daily visitor capacity (visitor-equiv.)\n    kappa        = 19.5,            # congestion-cost coefficient ($ per vis^2 / K0)\n    K_env        = 15_000.0,        # daily load above which site degradation accelerates\n    phi          = 1.0e-3,          # site-degradation coefficient\n    iota         = 4.0,             # public service cost $/visitor-day\n    L_cap        = 4_000.0,         # peak-day lodging-limited cap on land visitors\n\n    # ---- dynamics --------------------------------------------------------\n    g            = 0.030,           # baseline tourism demand growth / yr\n    beta         = 0.96,            # annual discount factor\n    eps_fee      = 0.10,            # elasticity of cruise demand to port fee\n    eps_bedtax   = 0.25,            # elasticity of land demand to bed tax\n\n    # ---- policy ----------------------------------------------------------\n    f_cap_week   = 16_000.0,        # cap Sun-Fri from 2026\n    f_cap_sat    = 12_000.0,        # cap Saturday from 2026\n    ships_cap    = 5,               # 5-ship/day MOA from 2024\n)\n\nNp   = P[\"N_res\"]\nRHO  = P[\"retention\"]\n\n# --- derived net local economic value per visitor -----------------------\nm_c = RHO*(P[\"spend_pax\"]+P[\"spend_line\"]+P[\"spend_crew\"]) + P[\"marine_rev\"]/P[\"C_2023\"]\nm_l = RHO*P[\"land_spend\"]\nP[\"m_c\"] = m_c\nP[\"m_l\"] = m_l\n\n# =====================================================================\n# 2.  CORE FUNCTIONS\n# =====================================================================\ndef total_daily_visitors(C, L):\n    return C + L\n\ndef congestion(V, K0, kappa):\n    \"\"\"convex congestion / crowding disamenity (social cost), $/day\"\"\"\n    return 0.5 * kappa * V**2 / K0\n\ndef site_damage(V, K_env, phi):\n    \"\"\"environmental site degradation (glacier, trails, wildlife), $/day\"\"\"\n    excess = max(0.0, V - K_env)\n    return phi * excess**2\n\ndef daily_welfare(C, L, p=P):\n    \"\"\"net social welfare for one day, $\"\"\"\n    V = C + L\n    benefit = p[\"m_c\"]*C + p[\"m_l\"]*L\n    carbon  = p[\"SCC\"]*(p[\"e_c\"]*C + p[\"e_l\"]*L)\n    cong    = congestion(V, p[\"K0\"], p[\"kappa\"])\n    site    = site_damage(V, p[\"K_env\"], p[\"phi\"])\n    infra   = p[\"iota\"]*V\n    return benefit - carbon - cong - site - infra\n\ndef marginal_external_cost_cruise(C, L, p=P):\n    \"\"\"d(ext)/dC : carbon + congestion + site + public service\"\"\"\n    V = C + L\n    return (p[\"SCC\"]*p[\"e_c\"] + p[\"kappa\"]*V/p[\"K0\"]\n            + (2*p[\"phi\"]*max(0.0, V-p[\"K_env\"])) + p[\"iota\"])\n\ndef marginal_external_cost_land(C, L, p=P):\n    V = C + L\n    return (p[\"SCC\"]*p[\"e_l\"] + p[\"kappa\"]*V/p[\"K0\"]\n            + (2*p[\"phi\"]*max(0.0, V-p[\"K_env\"])) + p[\"iota\"])\n\n# ---------------------------------------------------------------------\ndef solve_peak_day(p=P, fixed_L=None):\n    \"\"\"\n    Welfare-maximising peak-day (C,L) with operational caps; returns dict.\n    \"\"\"\n    def neg(Cc):\n        C, L = Cc\n        C = min(C, p[\"f_cap_week\"])\n        L = min(L, p[\"L_cap\"])\n        return -daily_welfare(C, L, p)\n    best = None\n    for C0 in (12000, 16000, 20000):\n        for L0 in (2000, 4000):\n            r = minimize(neg, [C0, L0], method=\"Nelder-Mead\",\n                         options=dict(xatol=1, fatol=1e-3, maxiter=4000))\n            if best is None or r.fun < best.fun:\n                best = r\n    C, L = best.x\n    C = min(C, p[\"f_cap_week\"]); L = min(L, p[\"L_cap\"])\n    V = C+L\n    out = dict(C=C, L=L, V=V, welfare=daily_welfare(C, L, p),\n               benefit=p[\"m_c\"]*C+p[\"m_l\"]*L,\n               carbon=p[\"SCC\"]*(p[\"e_c\"]*C+p[\"e_l\"]*L),\n               congestion=congestion(V, p[\"K0\"], p[\"kappa\"]),\n               site=site_damage(V, p[\"K_env\"], p[\"phi\"]),\n               infra=p[\"iota\"]*V,\n               emc_c=marginal_external_cost_cruise(C, L, p),\n               emc_l=marginal_external_cost_land(C, L, p))\n    out[\"pigouvian_fee\"] = out[\"emc_c\"]      # efficient marine passenger fee\n    return out\n\n# ---------------------------------------------------------------------\ndef seasonal_profile(days, a=5.0, b=5.0):\n    \"\"\"Beta(5,5)-like unimodal seasonal shape on [0,1], normalised to mean 1.\"\"\"\n    x = (np.arange(days) + 0.5) / days\n    f = x**(a-1) * (1-x)**(b-1)\n    return f / f.mean()\n\ndef build_daily_series(annual_total, days, a=5.0, b=5.0):\n    \"\"\"daily arrivals summing to annual_total, with realistic seasonality.\"\"\"\n    return seasonal_profile(days, a, b) * (annual_total/days)\n\n# ---------------------------------------------------------------------\ndef simulate(year, policy, base=P):\n    \"\"\"Simulate one season; returns aggregated results for the given policy dict.\"\"\"\n    p = dict(base)\n    days = int(p[\"season_days\"])\n    # demand growth from 2023 baseline\n    growth = (1+p[\"g\"])**(year-2023)\n    C_target = p[\"C_2023\"]*growth\n    L_target = p[\"L_2023\"]*growth\n\n    # --- fee response (cruise) ------------------------------------------\n    fee = policy.get(\"fee\", p[\"head_tax0\"])\n    bed = policy.get(\"bed_tax\", p[\"bed_tax\"])\n    d_fee = 1 - p[\"eps_fee\"]*max(0.0, (fee-p[\"head_tax0\"]))/max(p[\"head_tax0\"],1e-9)*0.5\n    d_bed = 1 - p[\"eps_bedtax\"]*max(0.0, (bed-p[\"bed_tax\"]))/max(p[\"bed_tax\"],1e-9)*0.5\n    C_target *= max(0.5, d_fee)\n    L_target *= max(0.5, d_bed)\n\n    # --- dispersal marketing grows land + non-cruise segment -------------\n    disp = policy.get(\"dispersal\", 0.0)      # 0..1 marketing/dispersal intensity\n    L_target *= (1 + policy.get(\"disp_gain\", 0.15)*disp)\n\n    # --- investment feedback: lower carbon, expand capacity --------------\n    carbon_cut  = policy.get(\"carbon_cut\", 0.0)   # 0..0.20 fraction reduction e_c\n    cap_expand  = policy.get(\"cap_expand\", 0.0)   # 0..0.15 fraction K0 increase\n    social_cut  = policy.get(\"social_cut\", 0.0)   # 0..0.20 housing alleviation\n    p[\"e_c\"] *= (1-carbon_cut)\n    p[\"K0\"]  *= (1+cap_expand)\n    p[\"kappa\"] *= (1-social_cut)\n\n    # --- daily series + caps ---------------------------------------------\n    Cs = build_daily_series(C_target, days, 5.0, 5.0)\n    Ls = build_daily_series(L_target, days, 3.5, 3.5)\n    Ccap = policy.get(\"cap_week\", None)\n    if Ccap is not None:\n        Cs = np.minimum(Cs, Ccap)\n    Ls = np.minimum(Ls, p[\"L_cap\"])\n\n    Vs = Cs + Ls\n    V = Cs.sum() + Ls.sum()\n    benef = p[\"m_c\"]*Cs.sum() + p[\"m_l\"]*Ls.sum()\n    carbon = p[\"SCC\"]*(p[\"e_c\"]*Cs.sum() + p[\"e_l\"]*Ls.sum())\n    carbon_t = p[\"e_c\"]*Cs.sum() + p[\"e_l\"]*Ls.sum()\n    cong = sum(congestion(v, p[\"K0\"], p[\"kappa\"]) for v in Vs)\n    site = sum(site_damage(v, p[\"K_env\"], p[\"phi\"]) for v in Vs)\n    infra = p[\"iota\"]*V\n    welfare = benef - carbon - cong - site - infra\n\n    # --- revenue ---------------------------------------------------------\n    gross_spend = p[\"spend_pax\"]*Cs.sum() + p[\"land_spend\"]*Ls.sum()\n    fee_rev = fee*Cs.sum()\n    bed_rev = bed*p[\"land_spend\"]*Ls.sum()*0.6   # ~60% of land spend is lodging\n    sales_rev = p[\"sales_tax\"]*gross_spend\n    total_rev = fee_rev + bed_rev + sales_rev + p[\"marine_rev\"]\n\n    # --- resident wellbeing index (0-1, higher better) -------------------\n    social = cong + site + infra\n    rwi = float(np.clip(1 - social/max(benef,1.0), 0.0, 1.0))\n\n    return dict(year=year, C=float(Cs.sum()), L=float(Ls.sum()), V=float(V),\n                peak_C=float(Cs.max()), peak_V=float(Vs.max()),\n                benefit=float(benef), carbon_cost=float(carbon), carbon_t=float(carbon_t),\n                congestion=float(cong), site=float(site), infra=float(infra),\n                welfare=float(welfare), gross_spend=float(gross_spend),\n                fee_rev=float(fee_rev), bed_rev=float(bed_rev), sales_rev=float(sales_rev),\n                total_rev=float(total_rev), rwi=rwi)\n\n# =====================================================================\n# 3.  SCENARIOS\n# =====================================================================\ndef run_scenarios():\n    scenarios = {\n        \"S0_status_quo\":      dict(),\n        \"S1_caps_only\":       dict(cap_week=P[\"f_cap_week\"]),\n        \"S2_fees_only\":       dict(fee=95.0, bed_tax=0.12),\n        \"S3_integrated\":      dict(cap_week=P[\"f_cap_week\"], fee=95.0, bed_tax=0.12,\n                                   dispersal=1.0, carbon_cut=0.15,\n                                   cap_expand=0.12, social_cut=0.20),\n    }\n    years = [2024, 2026, 2028, 2030, 2033, 2035]\n    table = {}\n    for name, pol in scenarios.items():\n        table[name] = [simulate(y, pol) for y in years]\n    # 10-yr discounted welfare per scenario (2026-2035)\n    disc = {}\n    for name, pol in scenarios.items():\n        tot = 0.0\n        for y in range(2026, 2036):\n            tot += simulate(y, pol)[\"welfare\"]*(P[\"beta\"]**(y-2026))\n        disc[name] = tot\n    return table, disc\n\n# =====================================================================\n# 4.  REINVESTMENT PORTFOLIO\n# =====================================================================\nPORTFOLIO = {\n    \"Infrastructure (water/wastewater/roads/dock)\": 0.25,\n    \"Transit & shuttle (congestion, dispersal)\":     0.22,\n    \"Workforce/affordable housing fund\":             0.20,\n    \"Environmental restoration & monitoring\":        0.18,\n    \"Carbon abatement / shore power\":                0.10,\n    \"Marketing of less-visited attractions\":         0.05,\n}\n\ndef allocate(new_revenue, weights):\n    \"\"\"Maximise sum w_j sqrt(x_j) s.t. sum x_j = R  ->  x_j = R * w_j^2 / sum w^2.\"\"\"\n    w = np.array(list(weights.values())); w = w/w.sum()\n    x = new_revenue * w**2 / (w**2).sum()\n    return {k: float(v) for k, v in zip(weights.keys(), x)}\n\n# =====================================================================\n# 5.  SENSITIVITY\n# =====================================================================\ndef oat_sensitivity(base_out, keys, pct=0.20):\n    \"\"\"One-at-a-time elasticity of peak-day optimal C and of net welfare.\"\"\"\n    res = {}\n    base_C = base_out[\"C\"]; base_W = base_out[\"welfare\"]\n    for k in keys:\n        row = {}\n        for sgn in (+1, -1):\n            p = dict(P); p[k] = P[k]*(1+sgn*pct)\n            p[\"m_c\"] = RHO*(p[\"spend_pax\"]+p[\"spend_line\"]+p[\"spend_crew\"]) + p[\"marine_rev\"]/p[\"C_2023\"]\n            p[\"m_l\"] = RHO*p[\"land_spend\"]\n            o = solve_peak_day(p)\n            row[\"hi\" if sgn>0 else \"lo\"] = (o[\"C\"], o[\"welfare\"])\n        # elasticity = (dY/Y)/(dX/X)\n        dY_C = (row[\"hi\"][0]-row[\"lo\"][0])/(2*base_C) if base_C else 0\n        dY_W = (row[\"hi\"][1]-row[\"lo\"][1])/(2*abs(base_W)) if base_W else 0\n        res[k] = dict(elasticity_C=2*dY_C/(2*pct), elasticity_W=2*dY_W/(2*pct),\n                      C_range=[row[\"lo\"][0], row[\"hi\"][0]],\n                      W_range=[row[\"lo\"][1], row[\"hi\"][1]])\n    return res\n\ndef _model_output(theta, base=P):\n    \"\"\"Scalar model output for Sobol: 10-yr discounted welfare under integrated policy.\"\"\"\n    keys = [\"spend_pax\",\"land_spend\",\"SCC\",\"e_c\",\"kappa\",\"phi\",\"g\",\"eps_fee\"]\n    p = dict(base)\n    for k, v in zip(keys, theta):\n        p[k] = v\n    p[\"m_c\"] = RHO*(p[\"spend_pax\"]+p[\"spend_line\"]+p[\"spend_crew\"]) + p[\"marine_rev\"]/p[\"C_2023\"]\n    p[\"m_l\"] = RHO*p[\"land_spend\"]\n    pol = dict(cap_week=p[\"f_cap_week\"], fee=95.0, bed_tax=0.12,\n               dispersal=1.0, carbon_cut=0.15, cap_expand=0.12, social_cut=0.20)\n    tot = 0.0\n    for y in range(2026, 2036):\n        tot += simulate(y, pol, base=p)[\"welfare\"]*(p[\"beta\"]**(y-2026))\n    return tot/1e9   # in $bn\n\ndef sobol_analysis(n=2048, seed=7):\n    \"\"\"Saltelli first-order & total-order Sobol indices (numpy).\"\"\"\n    rng = np.random.default_rng(seed)\n    # === ranges ===\n    lo = np.array([120.0, 150.0,  51.0, 0.20, 10.0, 0.2e-3, 0.010, 0.03])\n    hi = np.array([280.0, 350.0, 300.0, 0.55, 30.0, 2.0e-3, 0.060, 0.25])\n    D  = len(lo)\n    A  = lo + (hi-lo)*rng.random((n, D))\n    B  = lo + (hi-lo)*rng.random((n, D))\n    fA = np.array([_model_output(a) for a in A])\n    fB = np.array([_model_output(b) for b in B])\n    varY = np.var(np.concatenate([fA, fB]))\n    S1 = np.zeros(D); ST = np.zeros(D)\n    for i in range(D):\n        AB = A.copy(); AB[:, i] = B[:, i]\n        fAB = np.array([_model_output(r) for r in AB])\n        S1[i] = (np.mean(fB*(fAB-fA)))/varY\n        ST[i] = (np.mean((fA-fAB)**2))/(2*varY)\n    names = [\"spend_pax\",\"land_spend\",\"SCC\",\"e_c\",\"kappa\",\"phi\",\"growth_g\",\"eps_fee\"]\n    return {\"names\": names, \"S1\": S1.tolist(), \"ST\": ST.tolist(), \"varY\": float(varY)}\n\n# =====================================================================\n# 6.  ADAPTATION TO OTHER DESTINATIONS\n# =====================================================================\nDESTINATIONS = [\n    # name, peak visitors/resident, capacity ratio V/K0, fee elasticity, dispersion potential, carbon intensity\n    dict(name=\"Juneau, AK (cruise)\",        ratio=0.67, cap_ratio=2.0, eps=0.10, disp=0.75, ghg=0.95),\n    dict(name=\"Venice, IT (overnight+day)\", ratio=3.0,  cap_ratio=2.4, eps=0.35, disp=0.40, ghg=0.35),\n    dict(name=\"Barcelona, ES\",              ratio=1.2,  cap_ratio=1.6, eps=0.40, disp=0.60, ghg=0.30),\n    dict(name=\"Santorini, GR (cruise)\",     ratio=6.0,  cap_ratio=3.2, eps=0.15, disp=0.20, ghg=0.90),\n    dict(name=\"Machu Picchu, PE\",           ratio=0.9,  cap_ratio=2.8, eps=0.30, disp=0.25, ghg=0.20),\n    dict(name=\"Banff, CA\",                  ratio=1.5,  cap_ratio=1.4, eps=0.45, disp=0.65, ghg=0.25),\n]\n\ndef adaptation_index(d):\n    \"\"\"Composite overtourism stress index (0-100) and policy-fit scores.\"\"\"\n    stress = 100*(0.35*min(d[\"cap_ratio\"]/3.0,1.0)\n                  + 0.25*min(d[\"ratio\"]/4.0,1.0)\n                  + 0.20*d[\"ghg\"]\n                  + 0.20*(1-d[\"disp\"]))\n    # policy-fit: fee-first if inelastic demand; cap-first if high stress & low dispersion;\n    #             dispersal-first if high dispersion potential.\n    fee_fit   = 100*(1-d[\"eps\"])                      # inelastic -> fees work well\n    cap_fit   = 100*(d[\"cap_ratio\"]/3.0)\n    disp_fit  = 100*d[\"disp\"]\n    return dict(name=d[\"name\"], stress=round(stress,1),\n                fee_fit=round(fee_fit,1), cap_fit=round(cap_fit,1), disp_fit=round(disp_fit,1),\n                rec=(\"Cap-first + fee\" if cap_fit>=fee_fit and disp_fit<50\n                     else (\"Fee-first\" if fee_fit>disp_fit else \"Dispersal-first + fee\")))\n\n# =====================================================================\n# MAIN\n# =====================================================================\ndef main():\n    t0=time.time()\n    print(\"=\"*72); print(\"MANAGING SUSTAINABLE TOURISM - JUNEAU, ALASKA  (MCM 2025 B)\"); print(\"=\"*72)\n    print(f\"Calibrated unit values:  m_c = ${m_c:6.2f}/cruise-pax   m_l = ${m_l:6.2f}/land-visitor\")\n\n    # ---- baseline economics rebuilt from the report -------------------\n    direct = dict(passengers=320e6, cruise_lines=39e6, crew=16e6)\n    sectors = dict(tours=152e6, retail=144e6, restaurants=31e6, govt=22e6, transport=14e6, other=12e6)\n    print(f\"Direct spending total = ${sum(direct.values())/1e6:.0f}M ; sectors sum=${sum(sectors.values())/1e6:.0f}M\")\n\n    # ---- peak-day optimisation ----------------------------------------\n    peak = solve_peak_day()\n    print(\"\\n[2] Welfare-optimal peak day (with caps):\")\n    print(f\"    C* = {peak['C']:8.0f}   L* = {peak['L']:8.0f}   V* = {peak['V']:8.0f}\")\n    print(f\"    net welfare/day = ${peak['welfare']:,.0f}\")\n    print(f\"    efficient marine fee f* = ${peak['pigouvian_fee']:6.2f}/pax \"\n          f\"(EMC_c), EMC_land = ${peak['emc_l']:6.2f}\")\n\n    # unconstrained optimum (no caps)\n    p_unc = dict(P); p_unc[\"f_cap_week\"]=1e9; p_unc[\"L_cap\"]=1e9\n    unc = solve_peak_day(p_unc)\n    print(f\"    unconstrained peak V = {unc['V']:.0f} (caps bind: {unc['V']>peak['V']:.0f})\")\n\n    # ---- scenarios ------------------------------------------------------\n    table, disc = run_scenarios()\n    print(\"\\n[3] Scenario simulation (selected years):\")\n    print(f\"    {'scenario':<18}{'yr':>5}{'C':>10}{'L':>9}{'peak_V':>9}{'carbon_t':>10}{'welfare$M':>11}{'RWI':>6}\")\n    for name, rows in table.items():\n        for r in rows[:3]:\n            print(f\"    {name:<18}{r['year']:>5}{r['C']:>10,.0f}{r['L']:>9,.0f}\"\n                  f\"{r['peak_V']:>9,.0f}{r['carbon_t']:>10,.0f}{r['welfare']/1e6:>11,.1f}{r['rwi']:>6.2f}\")\n    print(\"    Discounted 2026-2035 welfare ($M):\",\n          {k: round(v/1e6,1) for k,v in disc.items()})\n\n    # ---- reinvestment ---------------------------------------------------\n    scen = {y: simulate(y, dict(cap_week=P[\"f_cap_week\"], fee=95.0, bed_tax=0.12,\n                                dispersal=1.0, carbon_cut=0.15, cap_expand=0.12,\n                                social_cut=0.20)) for y in range(2026,2036)}\n    new_rev = np.mean([scen[y][\"fee_rev\"]+scen[y][\"bed_rev\"] - \n                       (P[\"head_tax0\"]*scen[y][\"C\"]) for y in scen])\n    alloc = allocate(new_rev, PORTFOLIO)\n    print(f\"\\n[4] Mean annual NEW revenue (fees+fees on bed tax above baseline) = ${new_rev/1e6:.2f}M\")\n    for k,v in alloc.items(): print(f\"      {k:<48} ${v/1e6:6.2f}M\")\n\n    # ---- sensitivity -----------------------------------------------------\n    keys = [\"spend_pax\",\"land_spend\",\"SCC\",\"e_c\",\"kappa\",\"phi\",\"g\",\"eps_fee\"]\n    oat = oat_sensitivity(peak, keys)\n    print(\"\\n[5] OAT elasticities (peak C*, net welfare):\")\n    for k,v in oat.items():\n        print(f\"      {k:<12} eC={v['elasticity_C']:+.3f}   eW={v['elasticity_W']:+.3f}\")\n    sob = sobol_analysis(n=1024)\n    print(\"    Sobol first-order S1 / total-order ST:\")\n    for nm,s1,st in zip(sob[\"names\"],sob[\"S1\"],sob[\"ST\"]):\n        print(f\"      {nm:<12} S1={s1:+.3f}  ST={st:+.3f}\")\n\n    # ---- adaptation ------------------------------------------------------\n    adapt = [adaptation_index(d) for d in DESTINATIONS]\n    print(\"\\n[6] Destination adaptation:\")\n    for a in adapt:\n        print(f\"      {a['name']:<28} stress={a['stress']:5.1f}  rec={a['rec']}\")\n\n    # ---- persist ---------------------------------------------------------\n    out = dict(params={k:(v if not isinstance(v,float) else round(v,6)) for k,v in P.items()},\n               unit_values=dict(m_c=m_c, m_l=m_l),\n               economic_baseline=dict(direct=direct, sectors=sectors),\n               peak_optimal=peak, peak_unconstrained=unc,\n               scenarios=table, discounted_welfare_10y=disc,\n               new_revenue=new_rev, portfolio_allocation=alloc,\n               oat=oat, sobol=sob, adaptation=adapt,\n               runtime_s=round(time.time()-t0,2))\n    with open(os.path.join(RES,\"results.json\"),\"w\",encoding=\"utf-8\") as f:\n        json.dump(out, f, indent=2, default=float)\n    print(f\"\\nSaved -> results/results.json   ({out['runtime_s']}s)\")\n\nif __name__ == \"__main__\":\n    main()\n"
}
